---
import { skills } from '../data/resume.yaml'
import Headline from './Headline.astro'
import Paragraph from './Paragraph.astro'
import Title from './Title.astro'
const { full = false } = Astro.props
---

<Title>Skills</Title>
{skills.map((s) => (
  <div class="mb-3">
    <Headline>{s.category}</Headline>
    <Paragraph
      set:html={s.full ? `${s.items}<span class="${full ? '' : 'print:hidden'}">, ${s.full}</span>` : s.items}
    />
  </div>
))}
