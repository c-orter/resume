---
import { experience } from '../data/resume.yaml'
import Headline from './Headline.astro'
import Paragraph from './Paragraph.astro'
import SubTitle from './SubTitle.astro'
import Title from './Title.astro'
const { full = false } = Astro.props
---

<Title>Experience</Title>
{experience.map((job) => (
  <section class="mb-[2em] break-inside-avoid print:mb-[1em] last:mb-0">
    <section class="flex items-center justify-between">
      <SubTitle class="pr-[45px]">{job.position}</SubTitle>
      <SubTitle class="text-right" set:html={job.period} />
    </section>

    <Headline>{job.company}</Headline>
    {job.note && <Paragraph class="italic">{job.note}</Paragraph>}
    {job.groups.map((group) => (
      <>
        {group.heading && <Headline class="mt-[0.5em]">{group.heading}</Headline>}
        <div class="bullets">
          {group.bullets.map((bullet) => (
            <p class="bullet text-paragraph leading-(--lh) text-gray-800 dark:text-gray-300" set:html={`+ ${bullet}`} />
          ))}
          {(group.full ?? []).map((bullet) => (
            <p
              class:list={[
                'bullet text-paragraph leading-(--lh) text-gray-800 dark:text-gray-300',
                !full && 'print:hidden',
              ]}
              set:html={`+ ${bullet}`}
            />
          ))}
        </div>
      </>
    ))}
  </section>
))}

<style>
  .bullets {
    padding-left: 15px;
  }

  .bullet {
    padding-right: 30px;
    text-indent: -15px;
  }

  @media (max-width: 25cm) {
    .bullet {
      padding-right: 0;
    }
  }
</style>
