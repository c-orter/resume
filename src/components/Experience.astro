---
import { experience } from '../data/resume.yaml'
import Headline from './Headline.astro'
import SubTitle from './SubTitle.astro'
import Title from './Title.astro'
---

<Title>Experience</Title>
{experience.map((job) => (
  <section class="mb-[2em] last:mb-0">
    <section class="flex items-center justify-between">
      <SubTitle class="pr-[45px]">{job.position}</SubTitle>
      <SubTitle class="text-right" set:html={job.period} />
    </section>

    <Headline>{job.company}</Headline>
    <div class="bullets">
      {job.description.map((bullet) => (
        <p class="bullet text-paragraph leading-[22px] text-gray-800 dark:text-gray-300" set:html={`+ ${bullet}`} />
      ))}
    </div>
  </section>
))}

<style>
  .bullets {
    padding-left: 15px;
  }

  .bullet {
    padding-right: 30px;
    text-indent: -15px;
  }

  @media (max-width: 25cm) {
    .bullet {
      padding-right: 0;
    }
  }
</style>
