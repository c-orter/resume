---
import Clearance from './Clearance.astro'
import Contacts from './Contacts.astro'
import Education from './Education.astro'
import Experience from './Experience.astro'
import Header from './Header.astro'
import Projects from './Projects.astro'
import Skills from './Skills.astro'
import Summary from './Summary.astro'
const { full = false } = Astro.props
---

<div class="wrapper">
  <div class="header">
    <Header full={full} />
  </div>
  <div class="contacts">
    <Contacts />
  </div>
  <div class="skills">
    <Skills full={full} />
    <div class="clearance">
      <Clearance />
    </div>
  </div>
  <div class="experience">
    <Summary />
    <Experience full={full} />
    <div class="projects">
      <Projects />
    </div>
  </div>
  <div class="education">
    <Education />
  </div>
</div>

<style>
  .wrapper {
    display: grid;
    row-gap: 30px;
    grid-template-columns: 1fr 3fr;
    grid-template-rows: 190px 175px 205px auto auto;
    grid-template-areas:
      'header header'
      'contacts experience'
      'education experience'
      'skills experience'
      'skills experience';
  }
  .contacts,
  .skills,
  .education {
    padding: 0 22.5px 0 45px;
  }
  .clearance {
    margin-top: 45px;
  }
  .experience {
    padding: 0 45px 0 0;
  }
  .projects {
    margin-bottom: 30px;
    padding: 0;
  }

  @media (min-width: 25cm) {
    @media not print {
      .wrapper {
        padding: 0 0 45px 0;
      }
    }
  }

  .header {
    display: flex;
    grid-area: header;
    background-image: url('../assets/wave.svg');
    background-repeat: no-repeat;
  }
  .contacts {
    grid-area: contacts;
  }
  .skills {
    grid-area: skills;
  }
  .experience {
    grid-area: experience;
  }
  .education {
    grid-area: education;
  }

  @media (max-width: 25cm) {
    .wrapper {
      grid-template-columns: 1fr;
      grid-template-rows: auto auto auto auto auto auto auto;
      grid-template-areas:
        'header'
        'contacts'
        'experience'
        'education'
        'skills';
    }
    .header {
      background-image: url('../assets/wave-mobile.svg') !important;
    }
    .contacts,
    .skills,
    .experience,
    .education {
      padding: 0 20px 0 20px !important;
    }
  }
  @media print {
    /* The wave is screen-only, even when background graphics are enabled in the print dialog. */
    .header {
      background-image: none !important;
    }
    .projects {
      margin-bottom: 0;
    }
    .wrapper {
      grid-template-rows: auto 200px 200px auto;
      grid-template-areas:
        'header header'
        'contacts experience'
        'education experience'
        'skills experience';
    }
  }
</style>
