---
import { Icon } from 'astro-icon/components'
import { name, title } from '../data/resume.yaml'
import profile from '../assets/profile.jpg'
import { Image } from 'astro:assets'
import Button from './Button.astro'

const { full = false } = Astro.props
const icon = 'flex items-center text-[18px] leading-none'
---

<div class="w-full">
  <section class="toolbar mb-[-62px] flex items-center print:hidden">
    <div class="flex">
      <div class="relative">
        <Button id="print-button" aria-label="Print" aria-haspopup="menu" aria-expanded="false" aria-controls="print-menu">
          <Icon name="bi:printer-fill" class={`${icon} dark:text-white`} />
        </Button>
        <div
          id="print-menu"
          role="menu"
          hidden
          class="absolute top-full left-2.5 z-10 min-w-60 overflow-hidden rounded-lg bg-white shadow-lg dark:bg-gray-800"
        >
          {
            [
              { href: '/', label: 'Print short version' },
              { href: '/full', label: 'Print full version' },
            ].map(({ href, label }) => (
              <a
                href={`${href}?print`}
                data-path={href}
                role="menuitem"
                target="_self"
                class="block px-4 py-3 text-paragraph whitespace-nowrap text-black hover:bg-black/10 dark:text-white dark:hover:bg-white/10"
              >
                {label}
                {(href === '/full') === full && <span class="ml-1.5 text-xs text-gray-500 dark:text-gray-400">current</span>}
              </a>
            ))
          }
        </div>
      </div>
      <Button id="theme-button" aria-label="Toggle dark mode">
        <Icon name="bi:sun-fill" class={`${icon} hidden text-white dark:flex`} />
        <Icon name="bi:moon-fill" class={`${icon} dark:hidden`} />
      </Button>
      <Button href="https://github.com/c-orter/resume" aria-label="Source on GitHub">
        <Icon name="bi:github" class={`${icon} dark:text-white`} />
      </Button>
    </div>
  </section>

  <div class="box">
    <div class="person-info">
      <h1 class="name text-[2em] leading-none font-extrabold tracking-[3px] uppercase dark:text-gray-200">{name}</h1>
      <h2 class="position text-subtitle leading-(--lh) font-extrabold tracking-[2px] text-blue-500 uppercase dark:text-blue-400">
        {title}
      </h2>
    </div>
    <div class="person-photo print:hidden">
      <Image src={profile} alt={name} width={200} height={200} class="size-[100px] rounded-full" />
    </div>
  </div>
</div>

<script>
  const printButton = document.getElementById('print-button')
  const menu = document.getElementById('print-menu')
  const setMenu = (open: boolean) => {
    if (menu) menu.hidden = !open
    printButton?.setAttribute('aria-expanded', String(open))
  }
  printButton?.addEventListener('click', (e) => {
    e.stopPropagation()
    setMenu(!!menu?.hidden)
  })
  document.addEventListener('click', () => setMenu(false))
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setMenu(false)
  })
  menu?.querySelectorAll<HTMLAnchorElement>('a').forEach((a) =>
    a.addEventListener('click', (e) => {
      if (a.dataset.path !== location.pathname.replace(/(.)\/$/, '$1')) return
      e.preventDefault()
      setMenu(false)
      window.print()
    }),
  )
  // Arrived from the other version's menu: open the print dialog once.
  if (new URLSearchParams(location.search).has('print')) {
    history.replaceState(null, '', location.pathname)
    window.print()
  }
  document.getElementById('theme-button')?.addEventListener('click', () => {
    const dark = document.documentElement.classList.toggle('dark')
    try {
      localStorage.setItem('vueuse-color-scheme', dark ? 'dark' : 'light')
    } catch {}
  })
</script>

<style>
  .toolbar {
    justify-content: start;
  }
  .person-info {
    display: flex;
    flex-direction: column;
  }
  .name {
    margin-bottom: 0.25em;
  }
  .position {
    margin: 0;
  }
  .box {
    padding: 45px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
  }

  @media (max-width: 12.9cm) {
    .toolbar {
      margin-bottom: 0;
    }
  }

  @media (max-width: 21cm), print {
    .toolbar {
      justify-content: space-between !important;
    }
    .box {
      padding-top: 20px;
      flex-direction: column-reverse;
    }
    .person-info {
      align-items: center;
      justify-content: center;
    }
    .person-photo {
      padding-bottom: 20px;
    }
    .name,
    .position {
      text-align: center;
    }
  }
  @media print {
    .box {
      padding-top: 20px;
    }
  }
</style>
